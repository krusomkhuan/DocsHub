# ข้อมูลผู้ใช้และไฟล์เฉพาะเครื่อง — ห้ามขึ้น git (repo สาธารณะ)
/uploads/*
!/uploads/.htaccess
/backups/*
!/backups/.htaccess
/includes/installed.lock

# ไฟล์ export ฐานข้อมูลของเครื่องอาจมีผู้ใช้/hash รหัสผ่าน/IP
# ไฟล์ติดตั้งที่สะอาดสร้างได้ด้วย: php tools/dump-schema.php --install
/database/*.sql
!/database/install.sql

# ไฟล์ที่อาจมีรหัสผ่าน
/user-pass.txt

# ไฟล์ทำงานส่วนตัวที่รากโปรเจกต์ (ไม่ใช่ส่วนของโปรแกรม)
/Prompt สร้างนิทานสำหรับเด็ก.docx
/คู่มือสร้างวีดีโอด้วย Claude Code.pdf
/ระบบกรอกข้อมูลคลังภาพ (การตอบกลับ).xlsx
/สร้างพร้อมในการสร้างระบบ.txt
/สร้างพร้อมในการสร้างระบบ-01.txt

/.claude/
*.log
__pycache__/
*.pyc
